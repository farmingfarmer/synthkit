{
  "title": "Progress note extraction test corpus",
  "structured_fields": [
    {
      "name": "encounter_id",
      "ftype": "id",
      "distribution": {
        "kind": "sequence",
        "params": {
          "prefix": "ENC-",
          "start": 10000
        }
      },
      "nullable_rate": 0.0
    },
    {
      "name": "patient_name",
      "ftype": "person_name",
      "distribution": {
        "kind": "categorical",
        "params": {
          "choices": [
            "x"
          ]
        }
      },
      "nullable_rate": 0.0
    },
    {
      "name": "admit_date",
      "ftype": "date",
      "distribution": {
        "kind": "date_range",
        "params": {
          "start": "2026-01-01",
          "end": "2026-06-30"
        }
      },
      "nullable_rate": 0.0
    },
    {
      "name": "discharge_date",
      "ftype": "date",
      "distribution": {
        "kind": "date_range",
        "params": {
          "start": "2026-01-01",
          "end": "2026-06-30"
        }
      },
      "nullable_rate": 0.0
    },
    {
      "name": "length_of_stay_days",
      "ftype": "int",
      "distribution": {
        "kind": "lognormal",
        "params": {
          "mu": 1.2,
          "sigma": 0.6,
          "min": 1,
          "max": 45
        }
      },
      "nullable_rate": 0.0
    }
  ],
  "unstructured_fields": [
    {
      "name": "progress_note",
      "note_type": "inpatient progress note",
      "target_elements": [
        {
          "element_id": "current_medication",
          "description": "an active medication with dose",
          "phrasings": [
            "continues {value} at current dose",
            "pt remains on {value}",
            "{value} — no changes today"
          ],
          "density": 0.9,
          "difficulty": "easy",
          "value_source": {
            "choices": [
              "metformin 500mg BID",
              "lisinopril 10mg daily",
              "atorvastatin 40mg nightly",
              "levothyroxine 75mcg qAM"
            ]
          }
        },
        {
          "element_id": "followup_appointment",
          "description": "a scheduled follow-up",
          "phrasings": [
            "follow up scheduled for {value}",
            "will see clinic again {value}"
          ],
          "density": 0.6,
          "difficulty": "medium",
          "value_source": {
            "choices": [
              "in two weeks",
              "in one month",
              "next Tuesday"
            ]
          }
        },
        {
          "element_id": "allergy_flag",
          "description": "a documented allergy",
          "phrasings": [
            "allergies: {value}",
            "known {value} allergy noted"
          ],
          "density": 0.4,
          "difficulty": "hard",
          "value_source": {
            "choices": [
              "penicillin",
              "sulfa",
              "latex"
            ]
          }
        }
      ],
      "distractors": [
        {
          "distractor_id": "discontinued_medication",
          "description": "a med explicitly STOPPED — must not be extracted as current",
          "phrasings": [
            "{value} discontinued this admission",
            "stopped {value} due to side effects"
          ],
          "density": 0.5,
          "value_source": {
            "choices": [
              "ibuprofen",
              "omeprazole"
            ]
          }
        }
      ],
      "style": {
        "personas": [
          "attending",
          "resident",
          "nurse"
        ],
        "verbosity": [
          "terse",
          "moderate",
          "verbose"
        ],
        "abbreviation": [
          "none",
          "moderate",
          "heavy"
        ]
      },
      "length_words": [
        60,
        180
      ]
    }
  ],
  "cross_field_rules": [
    {
      "earlier": "admit_date",
      "later": "discharge_date",
      "min_delta": 1,
      "max_delta": 21
    }
  ],
  "corpus": {
    "size": 250,
    "master_seed": 42
  },
  "version": 1
}